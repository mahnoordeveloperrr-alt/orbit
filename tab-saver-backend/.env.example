# Server port
PORT=5000

# MongoDB connection string.
# ⚠️ NEVER commit the real value — use MongoDB Atlas → Database → Connect.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# Secret for signing JWT auth tokens.
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# SMTP account used for verification emails (use an app password, not your real password).
EMAIL_USER=
EMAIL_PASS=

# Public base URL used in email links (verification). Default: http://localhost:5000
APP_BASE_URL=
